[global]
    font = IosevkaTerm Nerd Font 10

    background = "#0D0D0DBB"
    foreground = "#eeeeee"

    frame_color = "#444444BB"
    highlight = "#B8B8B8BB"

    separator_height = 1
    separator_color = "#444444BB"

    width = 280
    height = 110
    offset = 15x15
    origin = top-right

    corner_radius = 0
    frame_width = 1

    gap_size = 10
    padding = 10
    horizontal_padding = 12
    text_icon_padding = 10

    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 280

[urgency_low]
    background = "#0D0D0DBB"
    foreground = "#B8B8B8"
    frame_color = "#444444BB"
    timeout = 5

[urgency_normal]
    background = "#0D0D0DBB"
    foreground = "#eeeeee"
    frame_color = "#444444BB"
    timeout = 10

[urgency_critical]
    background = "#eeeeeeBB"
    foreground = "#0D0D0D"
    frame_color = "#eeeeee"
    timeout = 0
